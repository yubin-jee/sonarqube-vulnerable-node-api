# Session configuration
SESSION_SECRET=your-session-secret-here

# JWT configuration
JWT_SECRET=your-jwt-secret-here

# OAuth configuration
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Service-to-service authentication
SERVICE_TOKEN=your-service-token-here

# Database configuration
DB_HOST=localhost
DB_USER=app_user
DB_PASSWORD=your-db-password-here
DB_NAME=app_development
DB_PORT=3306

# Database replica configuration
DB_REPLICA_HOST=localhost
DB_REPLICA_USER=readonly_user
DB_REPLICA_PASSWORD=your-replica-password-here

# MongoDB configuration
MONGO_HOST=localhost
MONGO_USER=admin
MONGO_PASSWORD=your-mongo-password-here

# External API configuration
EXTERNAL_API_KEY=your-external-api-key-here

# HTTP client API credentials
API_SERVICE_USERNAME=api_service_account
API_SERVICE_PASSWORD=your-api-service-password-here

# Product webhook
WEBHOOK_SECRET=your-webhook-secret-here
