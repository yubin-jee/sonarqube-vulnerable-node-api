# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-session-secret-here

# JWT
JWT_SECRET=your-jwt-secret-here
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Database (Primary)
DB_HOST=localhost
DB_USER=app_user
DB_PASSWORD=your-db-password-here
DB_NAME=app_db
DB_PORT=3306

# Database (Replica)
DB_REPLICA_HOST=localhost
DB_REPLICA_USER=readonly_user
DB_REPLICA_PASSWORD=your-replica-password-here

# MongoDB
MONGO_URI=mongodb://user:password@localhost:27017/products?authSource=admin

# Service Auth
SERVICE_TOKEN=your-service-token-here
ADMIN_API_KEY=your-admin-api-key-here
WEBHOOK_SECRET=your-webhook-secret-here

# External APIs
EXTERNAL_API_KEY=your-external-api-key-here
API_SERVICE_USERNAME=your-api-service-username
API_SERVICE_PASSWORD=your-api-service-password

# Encryption
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Open Redirect Allowlist (comma-separated hostnames)
ALLOWED_REDIRECT_HOSTS=
