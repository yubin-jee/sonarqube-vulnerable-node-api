# Session
SESSION_SECRET=your-session-secret-here

# Database (Primary)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=app
DB_PORT=3306

# Database (Replica)
DB_REPLICA_HOST=localhost
DB_REPLICA_USER=readonly_user
DB_REPLICA_PASSWORD=your-replica-password-here

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# OAuth
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Service-to-Service Auth
SERVICE_TOKEN=your-service-token-here

# MongoDB
MONGO_HOST=localhost
MONGO_USER=admin
MONGO_PASSWORD=your-mongo-password-here

# Webhook
WEBHOOK_SECRET=your-webhook-secret-here

# API Service Credentials
API_SERVICE_USERNAME=your-api-username-here
API_SERVICE_PASSWORD=your-api-password-here
