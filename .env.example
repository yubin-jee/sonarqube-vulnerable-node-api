# Session
SESSION_SECRET=your-session-secret-here

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
OAUTH_CLIENT_SECRET=your-oauth-client-secret-here
SERVICE_TOKEN=your-service-token-here

# Primary Database
DB_HOST=localhost
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=app_production
DB_PORT=3306

# Replica Database
DB_REPLICA_HOST=localhost
DB_REPLICA_USER=your-replica-user
DB_REPLICA_PASSWORD=your-replica-password

# MongoDB
MONGO_HOST=localhost
MONGO_USER=your-mongo-user
MONGO_PASSWORD=your-mongo-password
MONGO_URI=mongodb://user:pass@localhost:27017/products?authSource=admin

# External API
EXTERNAL_API_KEY=your-external-api-key
API_SERVICE_USERNAME=your-api-username
API_SERVICE_PASSWORD=your-api-password

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
